// Students Database
const studentsData = {
    "yasser zriouh": {
        name: "Yasser Zriouh",
        age: 15,
        class: "TCSF-1",
        grade: 12
    },
    "sanoubari mohamed": {
        name: "Sanoubari Mohamed",
        age: 17,
        class: "TCSF-1",
        grade: 15
    },
    "anas dali": {
        name: "Anas Dali",
        age: 15,
        class: "TCSF-1",
        grade: 10
    }
};

function getStudentInfo() {
    const inputName = document.getElementById('studentName').value.trim().toLowerCase();
    const resultCard = document.getElementById('resultCard');
    const errorMessage = document.getElementById('errorMessage');

    if (inputName === "") {
        alert("Please enter a student name!");
        return;
    }

    // Search for student in data
    if (studentsData[inputName]) {
        const student = studentsData[inputName];

        // Populate details
        document.getElementById('studentTitle').innerText = 👤 Student: ${student.name};
        document.getElementById('studentAge').innerText = ${student.age} years old;
        document.getElementById('studentClass').innerText = student.class;
        document.getElementById('studentGrade').innerText = ${student.grade} / 20;

        // Display card & hide error
        resultCard.classList.remove('hidden');
        errorMessage.classList.add('hidden');
    } else {
        // Display error & hide card
        errorMessage.classList.remove('hidden');
        resultCard.classList.add('hidden');
    }
}